{
  // ═══════════════════════════════════════════════════════════════════
  //  Stage 2 online RL config — Piper (7D: joint_1..6 rad + gripper m)
  //  Usage: python scripts/train_rlt_stage2_pi05.py --config configs/piper_stage2_pi05.json
  //  Differences vs configs/stage2_pi05.json:
  //    - robot_type "piper": CAN bus (no serial ports), PIPERFollower/
  //      PIPERLeader, 7D action/state (joint_1..6 in rad, gripper in m).
  //    - Policy actions go through send_policy_action; the safety limit is
  //      max_joint_step_rad (per-step radian delta), NOT the Feetech
  //      --max_relative_target degree clamp (rejected on Piper).
  //    - The leader mirror thread is disabled automatically: the CAN leader
  //      has no torque-enable/feedback write path. HIL takeover still works.
  //    - Tolerance/threshold values are in NATIVE units: radians for joints
  //      (gripper tolerance mixes meters; pick the larger of the two needs).
  //  This file supports // and /* */ comments (JSONC).
  // ═══════════════════════════════════════════════════════════════════

  // ── 1. Models & weights (frozen; only Actor/Critic are trained) ────
  "pi05_path": "/path/to/pi05/pretrained_model",   // frozen π0.5 base (7D action stats)
  "rlt_checkpoint": "/path/to/rlt_stage1/best_checkpoint.pt",  // Stage 1 RL Token encoder
  "tokenizer_path": "/path/to/paligemma_tokenizer",  // π0.5 language tokenizer
  "stats_path": "/path/to/piper_dataset/meta/stats.json",  // 7D quantile stats

  // ── 2. Task & hardware ─────────────────────────────────────────────
  "task": "Pick up the object and place it in the box",  // task instruction (fixed)
  "robot_type": "piper",          // piper = 7D CAN follower + leader; ports unused
  "max_joint_step_rad": 0.15,     // per-step joint delta limit (rad), applied inside
                                   // send_policy_action by the deployment controller.
                                   // Remove for the driver default (no final gate).
  "camera_names": ["top", "wrist"],
  "cameras": {
    "top":   { "type": "opencv", "index_or_path": 0, "width": 640, "height": 480, "fps": 30, "fourcc": "MJPG", "warmup_s": 3, "rotation": 0 },
    "wrist": { "type": "opencv", "index_or_path": 3, "width": 640, "height": 480, "fps": 30, "fourcc": "MJPG", "warmup_s": 3, "rotation": 0 }
  },
  "camera_map": {
    "top": "observation.images.top",
    "wrist": "observation.images.wrist"
  },

  // ── 3. RTC real-time chunked inference ──────────────────────────────
  "rtc_enabled": false,
  "rtc_execution_horizon": 10,
  "actor_residual_scale": 0.0,

  // ── 4. Control & episode pacing ────────────────────────────────────
  "policy_fixed_std": 0.05,
  "control_fps": 50.0,
  "steps_per_episode": 1000,
  "max_episodes": 1000,
  "warmup_episodes": 5,
  "actor_start_updates": 1000,
  "replan_every_window": true,
  "actor_execution_steps": 10,
  "reset_between_episodes": true,
  "manual_positioning": false,
  "reset_tolerance_deg": 0.10,    // NATIVE units on Piper: ~0.10 rad ≈ 5.7°
  "intervention_threshold": 0.15, // NATIVE units on Piper: rad (~8.6°)

  // ── 5. RL algorithm ────────────────────────────────────────────────
  "reference_dropout": 0.5,
  "online_bc_weight": 10.0,
  "online_q_weight": 1.0,
  "delta_weight": 0.0,
  "actor_lr": 3e-4,
  "critic_lr": 3e-4,
  "utd_ratio": 5,
  "critic_per_actor": 2,
  "batch_size": 256,
  "discount": 0.99,
  "target_tau": 0.005,
  "actor_hidden_dim": 256,
  "actor_num_layers": 2,
  "critic_hidden_dim": 256,
  "critic_num_layers": 2,

  // ── 6. Output ──────────────────────────────────────────────────────
  "output_dir": "outputs/rlt_stage2_pi05_piper",
  "device": "cuda",
  "dry_run": true                 // keep true until paths are filled in
}
